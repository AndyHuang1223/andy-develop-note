---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getUniqueCategories } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import { taxonomySlug } from "@/utils/paths";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getAllPosts();
	const sortedPosts = allPosts.sort(collectionDateSort);
	return getUniqueCategories(sortedPosts).flatMap((category) => {
		const postsInCategory = sortedPosts.filter((post) => post.data.category === category);
		return paginate(postsInCategory, {
			pageSize: 10,
			params: { category: taxonomySlug(category) },
		});
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props as Props;
const routeCategory = Astro.params.category ?? "";
const category =
	getUniqueCategories(await getAllPosts()).find((value) => taxonomySlug(value) === routeCategory) ??
	routeCategory;

const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← 上一頁", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "下一頁 →", url: page.url.next } }),
};
---

<PageLayout meta={{ title: `分類：${category}`, description: `分類「${category}」的所有文章。` }}>
	<nav class="mb-8" aria-label="Breadcrumbs">
		<a class="text-accent" href="/categories/">分類</a>
		<span aria-hidden="true">　›　</span>
		<span aria-current="page">{category}</span>
	</nav>
	<h1 class="title mb-10">分類：{category}</h1>
	<ul class="space-y-4">
		{page.data.map((post) => (
			<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
				<PostPreview as="h2" post={post} />
			</li>
		))}
	</ul>
	<Pagination {...paginationProps} />
</PageLayout>
